# mesh_demo — first end-to-end cell-mesh radio test on ESP32-C6.

# secp256k1 + deterministic ECDSA for cm_sig (mbedTLS-backed).
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y
CONFIG_MBEDTLS_ECDSA_DETERMINISTIC=y

# Disable curves we don't use — frees flash for the pre-signed cell deck
# (we're already at ~5% free with the deck embedded). Keep P-256 (used
# by some IDF internals) and SECP256K1 (the one we sign on).
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# Main task stack — ESP-NOW + mbedTLS want some headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Custom partition table — 2 MB app partition (default single-app is 1 MB,
# which doesn't fit WAMR + the cell-engine + the pre-signed cell deck).
# The XIAO ESP32-C6 has 4 MB physical flash, so bump flash size + use the
# 2 MB layout from partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Semantos cell-engine runs on WAMR. The managed component is auto-pulled by
# the semantos REQUIRES entry.
# Shrink the WASM execution stack from 16 KB default — instantiate
# allocates stack + heap + linear memory together; on a C6 the 128 KB
# linear memory + 16 KB stack + 8 KB heap pushes past the largest
# contiguous heap block after WAMR's 128 KB pool grabs its slice.
CONFIG_SEMANTOS_WASM_STACK_SIZE=8192

# WAMR-on-C6 requirements:
#   1. RIPEMD160 — needed by the cell-engine's hash160 host import.
#   2. WAMR reference-types — kernel module uses ref-typed table ops.
CONFIG_MBEDTLS_RIPEMD160_C=y
CONFIG_WAMR_ENABLE_REF_TYPES=y

# Disable HW ECC accelerator. The ESP32-C6 peripheral supports P-192/P-256
# only — the demo uses secp256k1, which falls back to software anyway, but
# leaving the HW path enabled causes ECDSA verify inside OP_CHECKSIG to
# return MBEDTLS_ERR_ECP_VERIFY_FAILED for sigs that verify cleanly via
# the lower-level (standalone-grp) path used in cm_sig_verify. Disabling
# HW ECC forces all curve ops onto the SW path uniformly.
CONFIG_MBEDTLS_HARDWARE_ECC=n

# Trim WiFi RX buffers so the cell-engine's 128 KB linear memory has
# room to coexist with ESP-NOW. Default 10 static × 1700 B = 17 KB;
# ESP-NOW is broadcast-only and doesn't need that many.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

# Logging at INFO level so we see TX/RX traces.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
