# temp_logger — store-and-forward temperature logger (docs/TEMP-LOGGER.md).
# Engine and radio settings follow examples/mesh_demo, which proved them.

# 4 MB flash, custom partition table with the `templog` data partition.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# The cell engine on WAMR (see mesh_demo/sdkconfig.defaults for why each).
CONFIG_SEMANTOS_WASM_STACK_SIZE=8192
CONFIG_MBEDTLS_RIPEMD160_C=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=y
CONFIG_MBEDTLS_ECDSA_DETERMINISTIC=y
CONFIG_MBEDTLS_HARDWARE_ECC=n

# Leave room for the engine's 128 KB linear memory next to ESP-NOW.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
